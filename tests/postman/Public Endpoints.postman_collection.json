{
  "info": {
    "_postman_id": "fb9d2487-27d1-4341-8128-9e517c48f54e",
    "name": "Public Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25814545"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('health payload', function () { pm.expect(json.status).to.eql('healthy'); pm.expect(json.database).to.eql('up'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (No Token Required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('auth_token', json.token);",
                  "pm.test('token exists', function () { pm.expect(json.token).to.be.a('string').and.not.empty; });",
                  "pm.test('user exists', function () { pm.expect(json).to.have.property('user'); pm.expect(json.user).to.have.property('uuid'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout (No Token Required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('logout payload', function () { pm.expect(json).to.have.property('message'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('login_email')) pm.collectionVariables.set('login_email', 'admin@moneymanager.com');",
          "if (!pm.collectionVariables.get('login_password')) pm.collectionVariables.set('login_password', 'ContraseniaSegura2026!');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080/api/v1"
    },
    {
      "key": "login_email",
      "value": "admin@moneymanager.com"
    },
    {
      "key": "login_password",
      "value": "ContraseniaSegura2026!"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ]
}