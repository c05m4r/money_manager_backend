        {
          "name": "Admin List Transaction Types (save uuid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const rows = Array.isArray(json.data) ? json.data : [];",
                  "pm.test('hay transaction types', function () { pm.expect(rows.length).to.be.greaterThan(0); });",
                  "const preferred = rows.find(x => (x.code || '').toUpperCase() === (pm.environment.get('transaction_type_code') || 'IN').toUpperCase()) || rows[0];",
                  "pm.environment.set('transaction_type_uuid', preferred.uuid);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
